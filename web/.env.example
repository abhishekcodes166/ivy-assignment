# Copy to .env.local for local development.
# On Vercel these go under Project Settings > Environment Variables instead.
#
# The unprefixed names used by the investigation scripts (API_KEY, BASE_URL) are
# also accepted - see vite.config.ts. Either spelling works.
#
# Both are read at BUILD time and inlined into the JS bundle, so changing them on
# Vercel requires a redeploy to take effect.

VITE_API_BASE_URL=https://solve.ivy.homes
VITE_API_KEY=your-ivy-api-key
