# Copy to .env.local for local development.
# On Vercel these are set under Project Settings > Environment Variables instead.
#
# Both are read at BUILD time and inlined into the JS bundle, so changing them
# in Vercel requires a redeploy to take effect.

VITE_API_BASE_URL=https://solve.ivy.homes
VITE_API_KEY=your-ivy-api-key
